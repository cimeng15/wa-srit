{
  "$schema": "../node_modules/@tauri-apps/cli/config.schema.json",
  "productName": "WaLite",
  "version": "0.1.0",
  "identifier": "id.smkdata.walite",
  "build": {
    "frontendDist": "../src"
  },
  "app": {
    "windows": [
      {
        "title": "WaLite",
        "url": "https://web.whatsapp.com",
        "width": 1100,
        "height": 750,
        "minWidth": 400,
        "minHeight": 500,
        "resizable": true,
        "center": true,
        "devtools": false
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": ["msi", "nsis"],
    "icon": ["icons/icon.ico"]
  }
}
